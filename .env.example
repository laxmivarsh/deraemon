# Doraemon Universe Environment Variables

# Public Supabase Connection (Optional - defaults to rich local canonical database if left blank)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Dashboard Password (Default for local development is "doraemon2112")
NEXT_PUBLIC_ADMIN_SECRET=doraemon2112

# Site Metadata
NEXT_PUBLIC_SITE_URL=https://doraemon-universe.vercel.app
